<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.agenticsdlc</groupId>
    <artifactId>agentic-sdlc-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>orchestrator-core</artifactId>
  <name>Orchestrator Core</name>
  <description>
    Pure domain and execution engine for the agentic SDLC orchestrator: the dependency
    graph, gates, the single-writer reducer, the hash-chained event log, policy, and
    reliability metrics. Deliberately framework-free.
  </description>

  <build>
    <plugins>
      <!--
        ARCHITECTURAL INVARIANT, ENFORCED AT BUILD TIME.

        orchestrator-core must never depend on Spring or on a JSON library.

        - No Spring: the entire engine has to be unit-testable with a fake Clock and no
          application context. If a Spring import ever sneaks in, that property quietly
          dies. A CLAUDE.md note would be advisory; this fails the build.
        - No Jackson: the audit hash chain is computed over our own canonical JSON
          encoder. If core could reach a general-purpose serializer, someone would hash
          its output, and a library upgrade would then silently invalidate every stored
          hash in the event log.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <id>core-stays-framework-free</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <includes>
                    <!-- Test-scope Spring arrives via spring-boot-starter-test; allowed. -->
                    <include>*:*:*:*:test</include>
                  </includes>
                  <excludes>
                    <exclude>org.springframework:*</exclude>
                    <exclude>org.springframework.boot:*</exclude>
                    <exclude>com.fasterxml.jackson.core:*</exclude>
                    <exclude>tools.jackson.core:*</exclude>
                  </excludes>
                  <message>
                    orchestrator-core must stay framework-free and must not depend on a
                    JSON library. See the comment in orchestrator-core/pom.xml.
                  </message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
